---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="page-head wrap">
  <h1 class="display h1">{title}</h1>
  {intro && <p class="lede">{intro}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(32px, 4vw, 48px);
  }
  h1 {
    max-width: 22ch;
  }
  .lede {
    margin-top: 16px;
  }
</style>
