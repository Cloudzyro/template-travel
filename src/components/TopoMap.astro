---
// A drawn topographic map: contour lines generated from a seed, a coastline,
// and the route as a line with numbered day stops. No map tiles, no requests.
interface Props {
  route: [number, number][];
  seed: number;
  labels?: string[];
  title: string;
  numbered?: boolean;
}
const { route, seed, labels = [], title, numbered = true } = Astro.props;

// Small deterministic random generator, so the same seed draws the same hills
function rng(s: number) {
  let x = s * 9301 + 49297;
  return () => {
    x = (x * 9301 + 49297) % 233280;
    return x / 233280;
  };
}
const rand = rng(seed);
const hills = Array.from({ length: 5 }, () => ({
  cx: 60 + rand() * 480,
  cy: 40 + rand() * 300,
  r: 50 + rand() * 70,
  a: rand() * 6.28,
  wob: 0.12 + rand() * 0.14,
}));

function ring(cx: number, cy: number, r: number, a: number, wob: number) {
  const pts: string[] = [];
  const n = 48;
  for (let i = 0; i <= n; i++) {
    const t = (i / n) * Math.PI * 2;
    const k = 1 + wob * Math.sin(3 * t + a) + wob * 0.6 * Math.cos(5 * t - a);
    const x = cx + Math.cos(t) * r * k * 1.25;
    const y = cy + Math.sin(t) * r * k * 0.85;
    pts.push(`${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return pts.join(" ") + " Z";
}
const contours = hills.flatMap((h) =>
  [1, 0.8, 0.62, 0.46, 0.32, 0.18].map((f, i) => ({ d: ring(h.cx, h.cy, h.r * f, h.a + i * 0.3, h.wob), index: i })),
);

// Coast along the bottom edge
const coastY = 352 + rand() * 20;
let coast = `M0 ${coastY}`;
for (let x = 0; x <= 600; x += 30) coast += ` Q${x + 15} ${coastY + (rand() - 0.5) * 26} ${x + 30} ${coastY + (rand() - 0.5) * 14}`;
coast += " L600 400 L0 400 Z";

// Smooth route through the stops
const routePath = route
  .map(([x, y], i) => {
    if (i === 0) return `M${x} ${y}`;
    const [px, py] = route[i - 1];
    const mx = (px + x) / 2;
    return `C${mx} ${py} ${mx} ${y} ${x} ${y}`;
  })
  .join(" ");
---

<svg class="topo" viewBox="0 0 600 400" role="img" aria-label={title}>
  <rect width="600" height="400" fill="#f4f3ec" />
  <g fill="none" stroke="#8b9a86" stroke-width="0.8">
    {contours.map((c) => <path d={c.d} stroke-opacity={c.index === 0 ? 0.45 : 0.3} stroke-width={c.index % 3 === 0 ? 1.1 : 0.7} />)}
  </g>
  <path d={coast} fill="#d9e3e3" stroke="#9fb3b4" stroke-width="1" />
  <g stroke="#1b2422" stroke-opacity="0.06">
    {[100, 200, 300, 400, 500].map((x) => <line x1={x} y1="0" x2={x} y2="400" />)}
    {[100, 200, 300].map((y) => <line x1="0" y1={y} x2="600" y2={y} />)}
  </g>
  <path d={routePath} fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" />
  <path d={routePath} fill="none" stroke="#a9471f" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 0" />
  {
    route.map(([x, y], i) => (
      <g>
        <circle cx={x} cy={y} r={numbered ? 11 : 5} fill={i === 0 || i === route.length - 1 ? "#a9471f" : "#fff"} stroke="#a9471f" stroke-width="2" />
        {numbered && (
          <text
            x={x}
            y={y + 4}
            text-anchor="middle"
            font-size="11"
            font-family="Work Sans Variable, sans-serif"
            fill={i === 0 || i === route.length - 1 ? "#fff" : "#a9471f"}
          >
            {i + 1}
          </text>
        )}
        {labels[i] && (
          <text x={x + 16} y={y - 12} font-size="12" font-family="Work Sans Variable, sans-serif" fill="#1b2422" paint-order="stroke" stroke="#f4f3ec" stroke-width="4">
            {labels[i]}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .topo {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
