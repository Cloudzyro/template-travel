---
import TopoMap from "./TopoMap.astro";
import type { Tour } from "../data/site";
import { money, fromPrice, destinationName, shortDate, monthOf } from "../lib/format";

interface Props {
  tour: Tour;
}
const { tour: t } = Astro.props;
const next = t.departures.find((d) => d.spaces > 0);
const months = [...new Set(t.departures.map((d) => monthOf(d.date)))].join(",");
---

<li
  class="tour"
  data-destination={t.destination}
  data-days={t.days}
  data-months={months}
>
  <a href={`/tours/${t.slug}`} class="link" aria-label={`${t.name}, ${t.days} days, from ${money(fromPrice(t))}`}></a>
  <div class="map">
    <TopoMap route={t.route} seed={t.terrain} numbered={false} title={`Route map of ${t.name}`} />
  </div>
  <div class="body">
    <p class="where muted">{destinationName(t.destination)} &middot; {t.from} to {t.to}</p>
    <h3 class="display">{t.name}</h3>
    <p class="summary">{t.summary}</p>
  </div>
  <dl class="facts">
    <div><dt>Days</dt><dd class="tnum">{t.days}</dd></div>
    <div><dt>Level</dt><dd>{t.level}</dd></div>
    <div><dt>From</dt><dd class="tnum">{money(fromPrice(t))}</dd></div>
    <div><dt>Next</dt><dd class="tnum">{next ? shortDate(next.date) : "Waitlist"}</dd></div>
  </dl>
</li>

<style>
  .tour {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 260px;
    gap: 32px;
    align-items: center;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }
  .map {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .where {
    font-size: 14px;
  }
  h3 {
    font-size: 26px;
    margin-top: 4px;
    transition: color 150ms var(--ease);
  }
  .tour:hover h3 {
    color: var(--accent);
  }
  .summary {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 15px;
    max-width: 34rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 16px;
  }
  dt {
    font-size: 13px;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
    font-size: 16px;
  }
  @media (max-width: 960px) {
    .tour {
      grid-template-columns: 180px minmax(0, 1fr);
    }
    .facts {
      grid-column: 2;
      grid-template-columns: repeat(4, auto);
      justify-content: start;
    }
  }
  @media (max-width: 600px) {
    .tour {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .facts {
      grid-column: 1;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
