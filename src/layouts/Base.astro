---
import "@fontsource-variable/literata";
import "@fontsource-variable/work-sans";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>;
}

const { title, description = site.description, schema } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const org = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  name: site.name,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  url: Astro.site?.toString(),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
};
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2f3ef" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema ?? org)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={`${site.name}, home`}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M5 24c4-1 5-8 10-9s6 4 11-6" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" />
            <circle cx="5" cy="24" r="3" fill="var(--accent)" />
            <circle cx="26" cy="9" r="3" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
          </svg>
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              site.nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + "/") ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn btn-primary btn-sm" href="/enquire">Enquire</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap grid">
        <div>
          <p class="f-name">{site.name}</p>
          <p class="muted">{site.tagline}. Twelve travelers at most.</p>
        </div>
        <div>
          <h2>Talk to us</h2>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a class="tnum" href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
          <p class="muted">{site.hours}</p>
        </div>
        <div>
          <h2>Office</h2>
          <p class="muted">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}</p>
        </div>
        <div>
          <h2>Pages</h2>
          <ul>
            {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/enquire">Enquire</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap legal">&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-size: 20px;
    text-decoration: none;
    margin-right: auto;
  }
  nav ul {
    display: flex;
    gap: 4px;
  }
  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 15px;
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--raised);
  }
  .site-footer {
    background: var(--ink);
    color: #c8cfcc;
    padding-top: 56px;
    font-size: 15px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr;
    gap: 32px;
  }
  .f-name {
    font-family: var(--display);
    font-size: 20px;
    color: #f2f3ef;
    margin-bottom: 8px;
  }
  .site-footer .muted {
    color: #9eaaa6;
  }
  .site-footer h2 {
    font-size: 15px;
    font-weight: 500;
    color: #f2f3ef;
    margin-bottom: 12px;
  }
  .site-footer p + p {
    margin-top: 6px;
  }
  .site-footer ul {
    display: grid;
    gap: 6px;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .legal {
    margin-top: 48px;
    padding-block: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: #9eaaa6;
    font-size: 14px;
  }
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      gap: 8px 16px;
      padding-block: 12px;
    }
    nav {
      order: 3;
      width: 100%;
    }
    nav a {
      padding-inline: 10px;
    }
    nav li:first-child a {
      padding-left: 0;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
