---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1 class="display h1">Off the map</h1>
    <p class="lede">That page isn't on any of our routes. The tours are a good place to pick up the trail again.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/tours">See the tours</a>
      <a class="btn btn-quiet" href="/">Home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: 120px 160px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
