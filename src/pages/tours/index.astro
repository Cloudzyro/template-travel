---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import TourRow from "../../components/TourRow.astro";
import { tours, destinations } from "../../data/site";
import { monthNames, monthOf } from "../../lib/format";

const months = [...new Set(tours.flatMap((t) => t.departures.map((d) => monthOf(d.date))))].sort((a, b) => a - b);
---

<Base title="Tours" description="Every Farline journey for 2027, filtered by destination, length and month.">
  <PageHead title="Tours for 2027" intro="Five journeys, six to eight days each. Filter by where, how long and when." />

  <section class="wrap" aria-label="Tours">
    <form class="filters" data-filters aria-label="Filter tours">
      <label class="field">
        <span>Destination</span>
        <select name="destination">
          <option value="">Anywhere</option>
          {destinations.map((d) => <option value={d.id}>{d.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Length</span>
        <select name="length">
          <option value="">Any length</option>
          <option value="short">6 days or fewer</option>
          <option value="long">7 days or more</option>
        </select>
      </label>
      <label class="field">
        <span>Month</span>
        <select name="month">
          <option value="">Any month</option>
          {months.map((m) => <option value={m}>{monthNames[m - 1]}</option>)}
        </select>
      </label>
      <p class="count muted tnum" role="status" aria-live="polite">{tours.length} tours</p>
    </form>

    <ul class="list">
      {tours.map((t) => <TourRow tour={t} />)}
    </ul>
    <p class="empty" hidden>No tours match. Try another month, or <a class="text-link" href="/enquire">ask us about private dates</a>.</p>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-filters]").forEach((form) => {
    const rows = [...document.querySelectorAll<HTMLElement>(".list .tour")];
    const count = form.querySelector<HTMLElement>(".count")!;
    const empty = document.querySelector<HTMLElement>(".empty")!;
    const params = new URLSearchParams(window.location.search);
    for (const key of ["destination", "length", "month"]) {
      const value = params.get(key);
      const el = form.elements.namedItem(key) as HTMLSelectElement;
      if (value && [...el.options].some((o) => o.value === value)) el.value = value;
    }
    const apply = () => {
      const data = new FormData(form);
      const dest = String(data.get("destination") ?? "");
      const length = String(data.get("length") ?? "");
      const month = String(data.get("month") ?? "");
      let shown = 0;
      rows.forEach((row) => {
        const days = Number(row.dataset.days);
        const ok =
          (!dest || row.dataset.destination === dest) &&
          (!length || (length === "short" ? days <= 6 : days >= 7)) &&
          (!month || (row.dataset.months ?? "").split(",").includes(month));
        row.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = `${shown} ${shown === 1 ? "tour" : "tours"}`;
      empty.hidden = shown > 0;
      const next = new URLSearchParams();
      if (dest) next.set("destination", dest);
      if (length) next.set("length", length);
      if (month) next.set("month", month);
      history.replaceState(null, "", next.size ? `?${next}` : location.pathname);
    };
    form.addEventListener("change", apply);
    form.addEventListener("submit", (e) => {
      e.preventDefault();
    });
    apply();
  });
</script>

<style>
  .filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 220px)) 1fr;
    gap: 16px;
    align-items: end;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line-strong);
  }
  .count {
    justify-self: end;
    padding-bottom: 12px;
    font-size: 15px;
  }
  .list {
    padding-bottom: 32px;
  }
  .empty {
    padding-block: 32px 112px;
    color: var(--ink-2);
  }
  section {
    padding-bottom: 80px;
  }
  @media (max-width: 760px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
    .count {
      justify-self: start;
    }
  }
</style>
